{
  "name": "barq-desktop",
  "version": "1.0.0",
  "description": "Barq AI Assistant - desktop Siri-style overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-startup": "powershell -ExecutionPolicy Bypass -File .\\install-startup.ps1",
    "dist": "electron-builder"
  },
  "author": "Barq",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "build": {
    "appId": "com.barq.assistant",
    "productName": "Barq Assistant",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}