# Barq configuration. Copy to .env and fill in what you need.
# API keys are set via environment variables or .env file

# Groq API (get key from https://console.groq.com)
GROQ_API_KEY=

# ElevenLabs (get key from https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=your_voice_id_here
ELEVEN_MODEL=eleven_multilingual_v2

# Picovoice wake word. Get a free access key at https://console.picovoice.ai
# Without it, Barq uses a Whisper-based fallback (works, but slower/wakes on
# any of the configured wake words).
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD=jarvis